    <string name="config_hint">يبحث البوت عن هذه النصوص داخل أي تطبيق على الشاشة. عدّل النصوص لتطابق ما يظهر في تطبيقك الهدف.</string>

    <string name="label_like_text">نص زر الإعجاب أو الاهتمام</string>
    <string name="hint_like_text">مثال: إهتمام أو اهتمام أو إعجاب</string>

    <string name="label_yes_text">نص زر التأكيد - نعم</string>
    <string name="hint_yes_text">مثال: نعم أو موافق أو تأكيد</string>

    <string name="label_close_text">نص زر الإغلاق - لرسائل النجاح والقيود</string>
    <string name="hint_close_text">مثال: إغلاق أو حسناً أو موافق</string>

    <string name="label_target_package">اسم حزمة التطبيق الهدف - اختياري</string>
    <string name="hint_target_package">اتركه فارغًا للعمل في أي تطبيق</string>

    <string name="label_profile_keywords">كلمات تدل على دخول الملف الشخصي بالخطأ - مفصولة بفاصلة</string>
    <string name="hint_profile_keywords">المؤهل التعليمي، الوزن، الطول</string>

    <string name="label_scan_interval">سرعة فحص الشاشة بالميلي ثانية</string>
    <string name="hint_scan_interval">مثال: 250 - الأقل أسرع لكن يستهلك بطارية أكثر</string>

    <string name="label_popup_wait">مدة انتظار ظهور النافذة المنبثقة بعد نقرة الإعجاب بالميلي ثانية</string>
    <string name="hint_popup_wait">مثال: 1500 ميلي ثانية - زدها إذا الإنترنت بطيء</string>

    <string name="label_idle_timeout">إيقاف تلقائي إذا لم يجد البوت أي زر إعجاب أو نعم لمدة (ثانية)</string>
    <string name="hint_idle_timeout">مثال: 30 - يتوقف بعد 30 ثانية من عدم وجود أزرار</string>

    <string name="label_dedup">تذكُّر الأعضاء بين الجلسات (يمنع التكرار)</string>
    <string name="label_dedup_desc">يستخدم قاعدة بيانات محلية لتسجيل الأعضاء الذين تمّ التفاعل معهم. لن يُكرّر البوت أبدًا.</string>

    <!-- v1.11 — like mode (filter divorced / widowed only) -->
    <string name="section_like_mode">وضع الإعجاب</string>
    <string name="section_like_mode_hint">اختر سلوك البوت عند العثور على عضوة في القائمة. الوضع الافتراضي هو العادي.</string>
    <string name="label_like_mode_normal">الوضع العادي — إعجاب لكل العضوات</string>
    <string name="label_like_mode_normal_desc">يضع البوت الإعجاب مباشرة على كل عضوة في القائمة دون فحص الحالة الاجتماعية.</string>
    <string name="label_like_mode_filter">المطلقات والأرامل فقط</string>
    <string name="label_like_mode_filter_desc">يدخل البوت إلى ملف كل عضوة، ويتحقق من الحالة الاجتماعية، ولا يضع الإعجاب إلا إذا كانت مطلقة أو أرملة. الأعضاء الذين سبق فحصهم لا يُعاد فتحهم.</string>

    <!-- v1.11 — refresh continuation mode -->
    <string name="section_refresh_mode">طريقة المتابعة بعد التحديث</string>
    <string name="section_refresh_mode_hint">عند تحديث صفحة المتواجدون الآن تلقائيًا، ماذا يفعل البوت؟</string>
    <string name="label_refresh_mode_restart">البدء من البداية</string>
    <string name="label_refresh_mode_restart_desc">يعود البوت إلى أول قائمة المتواجدون الآن من جديد بعد كل تحديث.</string>
    <string name="label_refresh_mode_continue">الاستمرار من حيث توقفت</string>
    <string name="label_refresh_mode_continue_desc">يكمل البوت من موقعه الأخير بعد التحديث، ويتخطى الأعضاء الذين سبق التفاعل معهم تلقائيًا (يتطلب تفعيل تذكُّر الأعضاء).</string>

