<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_title"
            android:accessibilityHeading="true"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_subtitle"/>

        <!-- Status section -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_status"
            android:accessibilityHeading="true"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_status_label"/>
        <TextView
            android:id="@+id/serviceStatusText"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="@string/service_status_disabled"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exec_status_label"/>
        <TextView
            android:id="@+id/execStatusText"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="@string/exec_status_idle"
            android:accessibilityLiveRegion="polite"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/counter_label"/>
        <TextView
            android:id="@+id/counterText"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="0"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skipped_label"/>
        <TextView
            android:id="@+id/skippedText"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="0"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_action_label"/>
        <TextView
            android:id="@+id/lastActionText"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:minHeight="48dp"
            android:text="@string/last_action_none"/>

        <!-- Actions section -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_actions"
            android:accessibilityHeading="true"/>

        <Button
            android:id="@+id/btnStart"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp"
            android:text="@string/btn_start"
            android:contentDescription="@string/btn_start"
            android:backgroundTint="@color/success"/>

        <Button
            android:id="@+id/btnStop"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp"
            android:text="@string/btn_stop"
            android:contentDescription="@string/btn_stop"
            android:backgroundTint="@color/stop_red"/>

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:textSize="17sp"
            android:textColor="@color/on_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_open_accessibility"
            android:contentDescription="@string/btn_open_accessibility"
            android:backgroundTint="@color/primary"/>

        <Button
            android:id="@+id/btnReset"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_reset"
            android:contentDescription="@string/btn_reset"
            android:backgroundTint="@color/surface_elevated"/>

        <Button
            android:id="@+id/btnClearHistory"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="56dp"
            android:text="@string/btn_clear_history"
            android:contentDescription="@string/btn_clear_history"
            android:backgroundTint="@color/surface_elevated"/>
    </LinearLayout>
</ScrollView>
