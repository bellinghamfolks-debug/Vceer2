<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_title"
            android:accessibilityHeading="true"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_subtitle"/>

        <!-- Status section -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_status"
            android:accessibilityHeading="true"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_status_label"/>
        <TextView
            android:id="@+id/serviceStatusText"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="@string/service_status_disabled"
            android:accessibilityLiveRegion="polite"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exec_status_label"/>
        <TextView
            android:id="@+id/execStatusText"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="@string/exec_status_idle"
            android:accessibilityLiveRegion="polite"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/counter_label"/>
        <TextView
            android:id="@+id/counterText"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="0"
            android:accessibilityLiveRegion="polite"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skipped_label"/>
        <TextView
            android:id="@+id/skippedText"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:minHeight="48dp"
            android:text="0"
            android:accessibilityLiveRegion="polite"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_action_label"/>
        <TextView
            android:id="@+id/lastActionText"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:minHeight="48dp"
            android:text="@string/last_action_none"
            android:accessibilityLiveRegion="polite"/>

        <!-- Config section -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_config"
            android:accessibilityHeading="true"/>

        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_hint"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_like_text"
            android:labelFor="@+id/inputLikeText"/>
        <EditText
            android:id="@+id/inputLikeText"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="@string/hint_like_text"
            android:inputType="text"
            android:contentDescription="@string/label_like_text"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_yes_text"
            android:labelFor="@+id/inputYesText"/>
        <EditText
            android:id="@+id/inputYesText"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="@string/hint_yes_text"
            android:inputType="text"
            android:contentDescription="@string/label_yes_text"/>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_close_text"
            android:labelFor="@+id/inputCloseText"/>
        <EditText
            android:id="@+id/inputCloseText"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="@string/hint_close_text"
            android:inputType="text"
            android:contentDescription="@string/label_close_text"/>

        <!-- Dedup switch — now a real toggle, not just an info card. -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/surface_elevated">
            <CheckBox
                android:id="@+id/checkDedup"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/label_dedup"
                android:checked="true"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_dedup"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/label_dedup_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- v1.11 — Like mode selector (normal vs filter divorced/widowed) -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="24dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_like_mode"
            android:accessibilityHeading="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_like_mode_hint"/>
        <RadioGroup
            android:id="@+id/groupLikeMode"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@color/surface_elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/radioLikeModeNormal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/label_like_mode_normal"
                android:minHeight="48dp"
                android:checked="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_like_mode_normal"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="32dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/label_like_mode_normal_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RadioButton
                android:id="@+id/radioLikeModeFilter"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/label_like_mode_filter"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_like_mode_filter"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="32dp"
                android:paddingEnd="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/label_like_mode_filter_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RadioGroup>

        <!-- v1.11 — Refresh continuation mode -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="24dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_refresh_mode"
            android:accessibilityHeading="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_refresh_mode_hint"/>
        <RadioGroup
            android:id="@+id/groupRefreshMode"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@color/surface_elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/radioRefreshModeContinue"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/label_refresh_mode_continue"
                android:minHeight="48dp"
                android:checked="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_refresh_mode_continue"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="32dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/label_refresh_mode_continue_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RadioButton
                android:id="@+id/radioRefreshModeRestart"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/label_refresh_mode_restart"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_refresh_mode_restart"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="32dp"
                android:paddingEnd="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/label_refresh_mode_restart_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RadioGroup>

        <!-- Advanced settings toggle — hidden by default because the defaults
             are correct for almost every user. -->
        <Button
            android:id="@+id/btnToggleAdvanced"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/btn_show_advanced"
            android:contentDescription="@string/btn_show_advanced"
            android:backgroundTint="@color/surface_elevated"/>

        <LinearLayout
            android:id="@+id/advancedSettings"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advanced_section_hint"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_target_package"
                android:labelFor="@+id/inputTargetPackage"/>
            <EditText
                android:id="@+id/inputTargetPackage"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/hint_target_package"
                android:inputType="text"
                android:contentDescription="@string/label_target_package"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_profile_keywords"
                android:labelFor="@+id/inputProfileKeywords"/>
            <EditText
                android:id="@+id/inputProfileKeywords"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/hint_profile_keywords"
                android:inputType="text"
                android:contentDescription="@string/label_profile_keywords"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_scan_interval"
                android:labelFor="@+id/inputScanInterval"/>
            <EditText
                android:id="@+id/inputScanInterval"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/hint_scan_interval"
                android:inputType="number"
                android:contentDescription="@string/label_scan_interval"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_popup_wait"
                android:labelFor="@+id/inputPopupWait"/>
            <EditText
                android:id="@+id/inputPopupWait"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/hint_popup_wait"
                android:inputType="number"
                android:contentDescription="@string/label_popup_wait"/>

            <TextView
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_idle_timeout"
                android:labelFor="@+id/inputIdleTimeout"/>
            <EditText
                android:id="@+id/inputIdleTimeout"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/hint_idle_timeout"
                android:inputType="number"
                android:contentDescription="@string/label_idle_timeout"/>
        </LinearLayout>

        <!-- v1.12 — saved coordinates (fallback for unlabeled buttons) -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="24dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_coords"
            android:accessibilityHeading="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="10dp"
            android:lineSpacingExtra="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_coords_hint"/>

        <Button
            android:id="@+id/btnRecordCoord"
            android:textSize="17sp"
            android:textColor="@color/on_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_record_coord"
            android:contentDescription="@string/btn_record_coord"
            android:backgroundTint="@color/primary"/>

        <LinearLayout
            android:id="@+id/coordsList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnClearCoords"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:text="@string/btn_clear_coords"
            android:contentDescription="@string/btn_clear_coords"
            android:visibility="gone"
            android:backgroundTint="@color/surface_elevated"/>

        <!-- Actions section -->
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="28dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_actions"
            android:accessibilityHeading="true"/>

        <Button
            android:id="@+id/btnStart"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp"
            android:text="@string/btn_start"
            android:contentDescription="@string/btn_start"
            android:backgroundTint="@color/success"/>

        <Button
            android:id="@+id/btnStop"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp"
            android:text="@string/btn_stop"
            android:contentDescription="@string/btn_stop"
            android:backgroundTint="@color/stop_red"/>

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:textSize="17sp"
            android:textColor="@color/on_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_open_accessibility"
            android:contentDescription="@string/btn_open_accessibility"
            android:backgroundTint="@color/primary"/>

        <Button
            android:id="@+id/btnReset"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_reset"
            android:contentDescription="@string/btn_reset"
            android:backgroundTint="@color/surface_elevated"/>

        <Button
            android:id="@+id/btnClearHistory"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_clear_history"
            android:contentDescription="@string/btn_clear_history"
            android:backgroundTint="@color/surface_elevated"/>

        <Button
            android:id="@+id/btnShareDiagnostic"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="56dp"
            android:text="@string/btn_share_diagnostic"
            android:contentDescription="@string/btn_share_diagnostic"
            android:backgroundTint="@color/surface_elevated"/>
    </LinearLayout>
</ScrollView>
