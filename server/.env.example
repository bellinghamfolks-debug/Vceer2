# Required
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional — shared secret between the web app and the proxy.
# If set, every API request must send the same value in the
# X-Basir-Client-Token header. Leave blank to allow public access.
BASIR_APP_TOKEN=

# Optional model overrides (defaults shown).
GEMINI_MODEL_FLASH_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Optional port (defaults to 3000).
PORT=3000
