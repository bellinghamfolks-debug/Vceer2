# ============================================================
# iOS / Xcode build artifacts (added v2.9.1 with iOS scaffold)
# ============================================================
# The Xcode project itself is generated from ios/project.yml via
# XcodeGen on every build, so we never commit it. Only the source
# files in ios/Basir/ and the YAML specs are tracked.
ios/Basir.xcodeproj/
ios/Basir.xcworkspace/
ios/build/
ios/DerivedData/
ios/Pods/
ios/*.ipa
ios/*.xcarchive
ios/Package.resolved
**/xcuserdata/
**/.swiftpm/

# Codemagic local cache
.codemagic/
